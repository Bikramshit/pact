        "body": "name: deploy-web-app ..."
      },
      "expect": "deny",
      "expect_reason": "contract_deny: net:*"
    },
    {
      "tool": "run_tests",
      "expect": "allow",
      "note": "fails on the seeded bug"
    },
    {
      "tool": "write_file",
      "args": {
        "path": "app/cart.py"
      },
      "expect": "allow",
      "content_from": "fixes/cart.py"
    },
    {
      "tool": "run_tests",
      "expect": "allow",
      "note": "passes after the fix"
    },
    {
      "tool": "deploy",
      "expect": "allow"
