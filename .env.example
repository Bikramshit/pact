# Copy to .env. The agent container gets none of these values except the model name.
# The Gemini key and the PACT_* settings go to pact-core only; each token also goes
# to the one container that checks it.

# Gemini API key. Needed for contract drafting and the live agent.
# Without it, PACT falls back to the pre-written contract and the replay agent.
GEMINI_API_KEY=

# A fast Gemini model available on your quota.
GEMINI_MODEL=gemini-3.8-flash

# Tried in order when the model above is overloaded or rate-limited.
GEMINI_FALLBACK_MODELS=gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash-lite

# on  = full broker: capabilities, policy, taint-gating, evidence (default)
# off = passthrough broker that executes every tool call with no checks
PACT_MODE=on

# Credentials pact-core uses for the mock targets and the test runner.
TARGET_TOKEN=dev-target-token
RUNNER_TOKEN=dev-runner-token
POSTGRES_PASSWORD=pact-dev

# Optional (defaults shown):
# PACT_POLICY_ENGINE=opa        # or native: the Go matcher, tested to give the same decisions
# PACT_HOLD_TIMEOUT=120s        # keep under 150s, the agent's own request timeout
# PACT_USER_KEYS=on             # off: judges cannot add their own Gemini key
# PACT_USER_KEY_IDLE=2h         # how long an unused judge key is kept (12h at most)
# PACT_ALLOWED_HOSTS=           # extra host names for the dashboard (localhost, IPs, *.sslip.io work already)
# PACT_KMS_ORG_KEY=             # Cloud KMS key versions, with make up-kms (see the README)
# PACT_KMS_ISSUER_KEY=
